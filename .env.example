# Public Supabase project values used by /oauth/consent/config.js.
# These are safe in a browser; never put the service-role/secret key here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Optional override; defaults to https://qalta.app
CONSENT_SITE_URL=https://qalta.app
