{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "qalta": {
      "type": "streamable-http",
      "url": "https://mcp.qalta.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "oidcEnabled": false,
            "authorizationServerBase": "https://mcp.qalta.app",
            "authorizationUrl": "https://mcp.qalta.app/oauth/authorize",
            "baseScopes": ["offline_access"],
            "defaultScopes": ["offline_access"],
            "oidcScopesSupported": []
          }
        }
      }
    }
  }
}
